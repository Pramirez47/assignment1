
ADDI X27, XZR, #54          // for testing
// Test case setup
ADDI X1, XZR, #0          // Set f = 0 (starting index)
ADDI X2, XZR, #6          // Set l = 6 (last index)

ADDI X12, XZR, #8         // Load the value 1 into X12
STUR X12, [X0, #0]       // a[0] = 8

ADDI X12, XZR, #3         // Load the value 3 into X12
STUR X12, [X0, #8]       // a[1] = 3

ADDI X12, XZR, #1        // Load the value 5 into X12
STUR X12, [X0, #16]      // a[2] = 1

ADDI X12, XZR, #7         // Load the value 7 into X12
STUR X12, [X0, #24]      // a[3] = 7

ADDI X12, XZR, #5         // Load the value 9 into X12
STUR X12, [X0, #32]      // a[4] = 5

ADDI X12, XZR, #2        // Load the value 11 into X12
STUR X12, [X0, #40]      // a[5] = 2

ADDI X12, XZR, #9        // Load the value 13 into X12
STUR X12, [X0, #48]      // a[6] = 9
BL partition
HALT 

partition:
    //assume f and l are in registers x1, x2
     // Calculate the address for a[f] (a + f * 8)
    LSL X12, X1, #3    // X12 = f * 8 (shift left i by 3)
    ADD X13, X0, X12   // X13 = base address + f * 8 (this is the address of a[f])
    LDUR X14, [X13, #0] // Load the value of a[j] into X14
    //SAVE P
    ORR X22, XZR, X14   //p = a[f]
    ADDI X9, X1, #1   //i = f + 1
    //SAVE j
    ORR X21, XZR, X2   //j = l
    loopPartition:

        // Check if i <= j
        SUBS X15, X9, X21   // Subtract j from i, result in X15, and set condition flags
        B.GT exitLoopPartition      // If i > j, exit the loop
        //save f, l
        ORR X19, XZR, X1   
        ORR X20, XZR, X2   

        //place parameters (a, i, l, p)
        ORR X1, XZR, X9     
        ORR X3, XZR, X22
        BL next_i //x4 is return value
        ORR X9, XZR, X4 
        PRNT X9
        //place parameters (a, j, f, p)
        ORR X1, XZR, X21
        ORR X2, XZR, X19
        ORR X3, XZR, X22
        BL next_j //x4 is return value
        ORR X10, XZR, X4 
        PRNT X10
        HALT
        SUBS X15, X9, X10   // Subtract j from i, result in X11, and set condition flags
        B.GT exitLoopPartition      // If i > j, exit the loop

        exitLoopPartition:
            BR LR               // Return from the function

next_i:
    //assume i, l, p are in registers x1, x2, x3
    PRNL 
    whileLoopI:
        //check if i is less or equal to l (this conditional seems to work)
        SUBS X9, X1, X2   // Compare i (X1) with l (X2)
        B.GE exitLoopI      // If i >= l, exit the loop
        // Calculate the address for a[i] (a + i * 8)
        LSL X10, X1, #3    // X10 = i * 8 (shift left i by 3)
        ADD X11, X0, X10   // X11 = base address + i * 8 (this is the address of a[i])
        
        //check if a[i] < p
        LDUR X12, [X11, #0] // Load the value of a[i] into X12
        // PRNT X12
        SUBS X13, X12, X3   // Compare a[i] (X14) with p (X3)
        B.GE exitLoopI       // If a[i] >= p, exit the loop
    
        // Increment i
        ADDI X1, X1, #1    // i++

        B whileLoopI         // Repeat the loop

    exitLoopI:
        
        ORR X4, XZR, X1     // Place return value in X4
        BR LR               // Return from the function

next_j:
    PRNL
    //assume j, f, p are in registers x1, x2, x3
    whileLoopJ:
        //check if i is less or equal to l (this conditional seems to work)
        SUBS X9, X2, X1   // Compare j (X1) with f (X2)
        B.GE exitLoopJ      // If f >= j, exit the loop

        // Calculate the address for a[i] (a + i * 8)
        LSL X10, X1, #3    // X10 = i * 8 (shift left i by 3)
        ADD X11, X0, X10   // X11 = base address + i * 8 (this is the address of a[i])
        
        //check if a[j] > p
        LDUR X12, [X11, #0] // Load the value of a[i] into X12
        // PRNT X12
        SUBS X13, X12, X3   // Compare a[j] (X12) with p (X3)
        B.LT exitLoopJ       // If a[j] <= p, exit the loop
    
        // Increment i
        SUBI X1, X1, #1    // i--
        B whileLoopJ         // Repeat the loop

    exitLoopJ:
        
        ORR X4, XZR, X1      // Place return value in X4
        // PRNT X4
        BR LR               // Return from the function

// Print array function (for testing purposes)
printArray:
    ADDI X9, XZR, #0       // Initialize loop counter (i = 0)
    PRNT X9
    printLoop:
        // Check if i >= n
        SUBS X10, X9, X20       // Compare i with n
        B.GE endPrintLoop      // Exit loop if i >= n

        // Calculate the address of a[i] (a + i * 8)
        LSL X12, X9, #3        // X12 = i * 8
        ADD X13, X0, X12       // X13 = base address + i * 8

        // Load a[i] and print it
        LDUR X11, [X13, #0]    // Load a[i] into X11
        PRNT X11               // Print the value of a[i] (you need a system call for this)

        // Increment i
        ADDI X9, X9, #1        // i++

        B printLoop            // Repeat the loop

    endPrintLoop:
        BR LR                  // Return from function

// Fill array function
fill: 
    // i variable = 0
    ADDI X9, XZR, #0   // Set i to 0 (X9 will be our loop index)

    // // Save n (X1) in X20 because we will modify X1
    // ADDI X20, X1, #0    // X19 = n (saving n in X19 for later use)

    // Start of loop
    fillLoop: 
        //make X2 equal to x19
        SUBS X10, X9, X1 // Compare i (X9) with n (X1) by calculating i - n
        B.GE exitLoopFill    // If i >= n, exit the loop
        
        // Calculate n - i - 1
        SUB X11, X1, X9   // X11 = n - i
        SUBI X11, X11, #1  // X11 = (n - i) - 1

        // Calculate the address for a[i] (a + i * 8)
        LSL X12, X9, #3   // X12 = i * 8 (shift left i by 3)
        ADD X13, X0, X12   // X13 = base address + i * 8 (this is the address of a[i])

        // Store (n - i - 1) into a[i]
        STUR X11, [X13, #0]  // Store X4 (n - i - 1) into a[i]

        // Increment i
        ADDI X9, X9, #1   // i++

        B fillLoop         // Jump back to the start of the loop

    // End of loop
    exitLoopFill:    
        BR LR                // Return from the function

// Swap function
swap:
    // Calculate the address for a[i] (a + i * 8)
    LSL X10, X1, #3        // X10 = i * 8 (shift left i by 3)
    ADD X11, X0, X10       // X11 = base address + i * 8 (this is the address of a[i])
    LDUR X12, [X11, #0]    // Load a[i] into a register
    ORR X9, XZR, X12       // Store a[i] in X9 (temp)
        
    // Calculate the address for a[j] (a + j * 8)
    LSL X13, X2, #3        // X13 = j * 8 (shift left j by 3)
    ADD X14, X0, X13       // X14 = base address + j * 8 (this is the address of a[j])
    LDUR X15, [X14, #0]    // Load a[j] into a register
    STUR X15, [X11, #0]    // Store a[j] at a[i]
    STUR X9, [X14, #0]     // Store temp (a[i]) at a[j]
    
    BR LR                  // Return from the function
